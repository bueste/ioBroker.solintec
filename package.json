{
    "name": "iobroker.solintec",
    "version": "0.1.0",
    "description": "ioBroker adapter for Solinteg MHT-25~50K-100 hybrid inverters with Dyness STACK100 battery, via local Modbus TCP.",
    "author": "Stefan Bühler",
    "homepage": "https://github.com/bueste/ioBroker.solintec",
    "license": "MIT",
    "keywords": ["ioBroker", "solinteg", "dyness", "stack100", "modbus", "inverter", "solar", "photovoltaik", "pv", "battery"],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bueste/ioBroker.solintec.git"
    },
    "bugs": {
        "url": "https://github.com/bueste/ioBroker.solintec/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "os": ["linux", "darwin", "win32"],
    "main": "main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "lib/",
        "io-package.json",
        "LICENSE",
        "main.js"
    ],
    "scripts": {
        "test:unit": "mocha test/unit --exit",
        "test:package": "mocha test/package --exit",
        "test": "npm run test:unit && npm run test:package",
        "test:integration": "mocha test/integration --exit",
        "lint": "eslint .",
        "translate": "translate-adapter",
        "release": "release-script"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.1",
        "modbus-serial": "^8.0.21"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^3.8.0",
        "@alcalzone/release-script-plugin-iobroker": "^3.7.1",
        "@alcalzone/release-script-plugin-license": "^3.7.0",
        "@iobroker/adapter-dev": "^1.3.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "chai": "^4.5.0",
        "mocha": "^10.7.3"
    }
}
